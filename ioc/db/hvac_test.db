# Multi-state status examples.
record(mbbi, "HVAC:AHU1:OperatingMode") {
    field(DESC, "AHU-1 operating mode")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(THVL, "3")
    field(ZRST, "OFF")
    field(ONST, "OCCUPIED")
    field(TWST, "UNOCCUPIED")
    field(THST, "WARMUP")
    field(VAL, "1")
}
record(mbbi, "HVAC:AHU1:DamperPositionStatus") {
    field(DESC, "AHU-1 outside-air damper status")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(THVL, "3")
    field(ZRST, "CLOSED")
    field(ONST, "MODULATING")
    field(TWST, "OPEN")
    field(THST, "FAULT")
    field(VAL, "1")
}
