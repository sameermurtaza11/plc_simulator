# Binary inputs: VAL=0/1, with descriptive state labels and native alarm severities.
record(bi, "HVAC:AHU1:SupplyFanRunning") {
    field(DESC, "AHU-1 supply fan run status")
    field(ZNAM, "STOPPED")
    field(ONAM, "RUNNING")
    field(VAL, "1")
    field(ZSV, "MAJOR")
    field(OSV, "NO_ALARM")
}
record(bi, "HVAC:AHU1:ReturnFanRunning") {
    field(DESC, "AHU-1 return fan run status")
    field(ZNAM, "STOPPED")
    field(ONAM, "RUNNING")
    field(VAL, "1")
    field(ZSV, "MAJOR")
    field(OSV, "NO_ALARM")
}
record(bi, "HVAC:AHU1:FilterDirty") {
    field(DESC, "AHU-1 dirty filter switch")
    field(ZNAM, "CLEAN")
