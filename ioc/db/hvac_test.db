# HVAC softIOC test database
# Simulation only: no hardware/device support. Intended for EPICS Base 7.0.x testing.
# Standard ai scaling fields are EGUF/EGUL; no hardware scaling is configured here.

record(ai, "HVAC:AHU1:SupplyAirTemp") {
    field(DESC, "AHU-1 supply air temperature")
    field(EGU, "degC")
    field(PREC, "1")
    field(VAL, "14.5")
    field(LOPR, "0")
    field(HOPR, "50")
    field(LOW, "10")
    field(LSV, "MINOR")
    field(HIGH, "30")
    field(HSV, "MINOR")
    field(HIHI, "35")
    field(HHSV, "MAJOR")
    field(LOLO, "5")
    field(LLSV, "MAJOR")
    field(HYST, "1")
}
record(ai, "HVAC:AHU1:ReturnAirTemp") {
    field(DESC, "AHU-1 return air temperature")
    field(EGU, "degC")
    field(PREC, "1")
    field(VAL, "24.0")
    field(LOPR, "0")
    field(HOPR, "50")
    field(LOW, "16")
    field(LSV, "MINOR")
    field(HIGH, "28")
    field(HSV, "MINOR")
    field(HIHI, "32")
    field(HHSV, "MAJOR")
    field(LOLO, "10")
    field(LLSV, "MAJOR")
    field(HYST, "1")
}
